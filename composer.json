{
    "name": "nemorize/nemorize",
    "description": "nemorize.me blog, built with Hanji, Blade and Markdown.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "nemorize/hanji": "^0.1.0",
        "scssphp/scssphp": "^2.1"
    },
    "config": {
        "allow-plugins": false,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "build": "@php vendor/bin/hanji build",
        "serve": "@php vendor/bin/hanji serve",
        "clean": "@php vendor/bin/hanji clean"
    }
}
