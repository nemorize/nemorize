{
    "name": "nemorize/nemorize",
    "description": "nemorize.me blog, built with Hanji, Blade and Markdown.",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "path",
            "url": "../hanji",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.5",
        "nemorize/hanji": "dev-main",
        "scssphp/scssphp": "^2.1"
    },
    "config": {
        "allow-plugins": false,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "build": "php bin/hanji build",
        "serve": "php bin/hanji serve",
        "clean": "php bin/hanji clean"
    }
}
